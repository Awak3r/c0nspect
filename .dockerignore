# The image needs only Go metadata, entrypoints and internal embedded assets.
**
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**

# Also exclude accidental local/private artifacts inside the allowed trees.
.git
.gitignore
.deploy
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
**/.operations.lock
**/.pytest_cache
**/.DS_Store
.vscode
.zed
.idea
backups
**/.partial-*
**/*.dump
**/*.tar.gz
**/config.env
**/compose.resolved.json
data
bin
/conspect
coverage*
*.test
*.out
*.log
node_modules
