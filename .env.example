# Copy to .env and chmod 600 .env. Never commit the filled file.
# DOMAIN is a DNS name only: no scheme, path or port.
DOMAIN=notes.example.com
APP_BASE_URL=https://${DOMAIN}

POSTGRES_DB=conspect
POSTGRES_USER=conspect
# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Compose expands these references. Percent-encode non-URL-safe credentials.
# sslmode=disable is only for the isolated Compose backend, never a remote DB.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable

# Generate ONCE with: openssl rand -hex 32
# Exactly 64 hex characters. Keep it with every backup: HMAC-derived public
# share URLs cannot be reproduced after restore if this secret is lost/changed.
APP_SECRET=
OWNER_USERNAME=admin
# Initial owner bootstrap only: 12..72 UTF-8 bytes. Quote passwords containing
# spaces/$/# with dotenv single quotes. Changes do NOT reset an existing owner.
OWNER_PASSWORD=

MAX_MARKDOWN_BYTES=2097152
MAX_IMAGE_BYTES=10485760
MAX_STORAGE_BYTES=1073741824

# Production Compose pins these values, irrespective of .env overrides.
# For a direct host process use DATA_DIR=./data and TRUST_PROXY=false.
APP_ADDR=:8080
DATA_DIR=/data
TRUST_PROXY=true
# deploy/compose.local.yaml overrides APP_BASE_URL=http://localhost:8080 and
# TRUST_PROXY=false; app/db ports are published on loopback only in that mode.
