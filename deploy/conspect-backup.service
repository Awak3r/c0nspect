[Unit]
Description=Conspect local database and uploads backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/conspect
ExecStart=/usr/bin/python3 /opt/conspect/deploy/scheduled_backup.py --nginx --keep 14
UMask=0077
Nice=10
TimeoutStartSec=1h
# Allow Python's interruption/finally cleanup to resume the briefly paused app.
KillSignal=SIGINT
TimeoutStopSec=3min
